<UserControl x:Class="MTWalk.WPF.Controls.Tree.TreeComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MTWalk.WPF.Controls.Tree"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <ComboBox x:Name="MainComboBox"
              IsEditable="True" 
              Text="{Binding SelectedText, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" 
              MaxDropDownHeight="300">

        <ComboBox.ItemContainerStyle>
            <Style TargetType="ComboBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>
        </ComboBox.ItemContainerStyle>

        <ComboBoxItem>
            <TreeView ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                      BorderThickness="0">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type local:ITree}" ItemsSource="{Binding Children}">
                        <HierarchicalDataTemplate.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ITreeNode}">
                                <StackPanel Orientation="Horizontal" 
                                    Margin="0,2" 
                                    Cursor="Hand" 
                                    Background="Transparent"
                                    MouseLeftButtonUp="OnItemNodeClicked">
                                    <TextBlock Text="{Binding NodeIcon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Foreground="Yellow" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </HierarchicalDataTemplate.ItemTemplate>
                        <StackPanel Orientation="Horizontal" 
                                    Margin="0,2" 
                                    Cursor="Hand" 
                                    Background="Transparent"
                                    MouseLeftButtonUp="OnItemNodeClicked">
                            <TextBlock Text="{Binding TreeIcon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Foreground="Yellow" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding}"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </ComboBoxItem>
    </ComboBox>
</UserControl>
