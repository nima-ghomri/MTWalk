<UserControl x:Class="MTWalk.WPF.Controls.Tree.TreeComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MTWalk.WPF.Controls.Tree"
             mc:Ignorable="d" 
             d:DesignHeight="450" 
             d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="HeaderedContentControl">
            <EventSetter Event="MouseLeftButtonUp" Handler="OnItemNodeClicked"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="HeaderedContentControl">
                        <StackPanel 
                           Margin="0,2" 
                           Cursor="Hand" 
                           Orientation="Horizontal" 
                           Background="Transparent">
                            <TextBlock 
                               Margin="0,0,5,0"
                               Text="{TemplateBinding Header}"
                               Foreground="{TemplateBinding BorderBrush}"/>
                            <ContentPresenter Content="{TemplateBinding Content}"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <HierarchicalDataTemplate x:Key="TreeTemplate" ItemsSource="{Binding Children}">
            <HeaderedContentControl 
                Content="{Binding}"
                Header="{Binding TreeIcon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                BorderBrush="{Binding TreeColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
            />
        </HierarchicalDataTemplate>

        <DataTemplate x:Key="NodeTemplate">
            <HeaderedContentControl 
                Content="{Binding}"
                Header="{Binding NodeIcon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                BorderBrush="{Binding NodeColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
             />
        </DataTemplate>

        <local:TreeNodeTemplateSelector x:Key="NodeSelector"
                       TreeTemplate="{StaticResource TreeTemplate}"
                       NodeTemplate="{StaticResource NodeTemplate}" />

        <Style x:Key="TreeViewItemStyle" TargetType="TreeViewItem">
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TreeViewItem_PreviewMouseLeftButtonDown"/>
        </Style>

        <Style x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>
    <ComboBox x:Name="MainComboBox"
              IsEditable="True" 
              ScrollViewer.CanContentScroll="False"
              MaxDropDownHeight="300"
              Text="{Binding SelectedValue, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" 
              ItemContainerStyle="{StaticResource ComboBoxItemStyle}">
        <ComboBoxItem>
            <TreeView 
                    x:Name="MainTreeView"
                    ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                    ItemTemplateSelector="{StaticResource NodeSelector}"
                    ItemContainerStyle="{StaticResource TreeViewItemStyle}"
                    BorderThickness="0">
            </TreeView>
        </ComboBoxItem>
    </ComboBox>
</UserControl>
