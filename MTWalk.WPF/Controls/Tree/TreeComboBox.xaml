<UserControl x:Class="MTWalk.WPF.Controls.Tree.TreeComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MTWalk.WPF.Controls.Tree"
             mc:Ignorable="d" 
             d:DesignHeight="450" 
             d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/MTWalk.WPF;component/Controls/Tree/TreeComboBox.Styles.xaml"/>
    </UserControl.Resources>
    <ComboBox x:Name="MainComboBox"
              IsEditable="True" 
              ScrollViewer.CanContentScroll="False"
              MaxDropDownHeight="300"
              Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" 
              ItemContainerStyle="{StaticResource ComboBoxItemStyle}">
        <ComboBoxItem>
            <TreeView 
                    x:Name="MainTreeView"
                    ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                    ItemTemplateSelector="{StaticResource NodeSelector}"
                    BorderThickness="0">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TreeViewItem_PreviewMouseLeftButtonDown"/>
                        <EventSetter Event="MouseLeftButtonUp" Handler="TreeViewItem_MouseLeftButtonUp"/>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>
        </ComboBoxItem>
    </ComboBox>
</UserControl>
