<UserControl x:Class="MTWalk.WPF.Inputs.InputsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:l="clr-namespace:MTWalk.WPF.Localization"
             xmlns:e="clr-namespace:MTWalk.WPF.Extensions" 
             xmlns:local="clr-namespace:MTWalk.WPF.Inputs"
             mc:Ignorable="d" 
             DataContext="{e:Resolve Type=local:InputsViewModel}"
             d:DataContext="{d:DesignInstance Type=local:InputsViewModel}"
             d:DesignHeight="450" 
             d:DesignWidth="800">
    <DataGrid 
        ItemsSource="{Binding Inputs}" 
        AutoGenerateColumns="False" 
        CanUserAddRows="False">
        <DataGrid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="{x:Static l:Strings.Load}" Command="{Binding LoadCommand}" />
                <MenuItem Header="{x:Static l:Strings.Save}" IsEnabled="False"/>
                <MenuItem Header="{x:Static l:Strings.Default}" IsEnabled="False"/>
            </ContextMenu>
        </DataGrid.ContextMenu>

        <!-- Column Definitions -->
        <DataGrid.Columns>
            <DataGridTextColumn Header="{x:Static l:Strings.Variable}" IsReadOnly="True" Width="*" />
            <DataGridTextColumn Header="{x:Static l:Strings.Value}" Width="*" />
            <DataGridTextColumn Header="{x:Static l:Strings.Start}" Width="*" />
            <DataGridTextColumn Header="{x:Static l:Strings.Step}" Width="*" />
            <DataGridTextColumn Header="{x:Static l:Strings.Stop}" Width="*" />
            <DataGridTextColumn Header="{x:Static l:Strings.Steps}" Width="*" />
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
