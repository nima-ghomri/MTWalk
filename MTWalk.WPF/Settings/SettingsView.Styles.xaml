<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <Thickness x:Key="Gap">3</Thickness>
    <system:Double x:Key="Small">150</system:Double>
    <system:Double x:Key="Medium">306</system:Double>
    <system:Double x:Key="Large">462</system:Double>
    <GridLength x:Key="LabelWidth">80</GridLength>
    
    <Style TargetType="HeaderedItemsControl" x:Key="InputsLabel">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="Control">
                    <Setter Property="Margin" Value="{StaticResource Gap}"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedItemsControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource LabelWidth}" />
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ContentPresenter Grid.Column="0"
                                      ContentSource="Header"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"/>
                        <Label Grid.Column="1" Content=":"/>
                        <ItemsPresenter Grid.Column="2"
                                    VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="StackPanel" x:Key="InputsGroup">
        <Style.Resources>
            <Style TargetType="HeaderedItemsControl" BasedOn="{StaticResource InputsLabel}" />
        </Style.Resources>
        <Setter Property="Margin" Value="{StaticResource Gap}"/>
    </Style>

    <Style TargetType="StackPanel" x:Key="InputsPanel">
        <Style.Resources>
            <Style TargetType="StackPanel" BasedOn="{StaticResource InputsGroup}" />
        </Style.Resources>
    </Style>
</ResourceDictionary>