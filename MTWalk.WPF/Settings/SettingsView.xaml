<UserControl x:Class="MTWalk.WPF.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MTWalk.WPF.Settings"
             xmlns:e="clr-namespace:MTWalk.WPF.Extensions"
             xmlns:l="clr-namespace:MTWalk.WPF.Localization"
             mc:Ignorable="d"        
             DataContext="{e:Resolve Type=local:SettingsViewModel}"
             d:DataContext="{d:DesignInstance Type=local:SettingsViewModel}"
             d:Background="White">
    <UserControl.Resources>
        <ResourceDictionary Source="/Settings/SettingsView.Styles.xaml" />
    </UserControl.Resources>
    <StackPanel Style="{StaticResource InputsPanel}">
        <StackPanel>
            <HeaderedItemsControl Header="{x:Static l:Words.Expert}">
                <ComboBox Width="{StaticResource Large}"
                      Text="{Binding Expert, UpdateSourceTrigger=PropertyChanged}"
                      ItemsSource="{Binding Experts}" 
                      IsEditable="True"/>
            </HeaderedItemsControl>
            <HeaderedItemsControl Header="{x:Static l:Words.Symbol}">
                <ComboBox Width="{StaticResource Medium}"
                      Text="{Binding Symbol, UpdateSourceTrigger=PropertyChanged}"
                      ItemsSource="{Binding Symbols}" 
                      IsEditable="True"/>
                <ComboBox Width="{StaticResource Small}"
                      SelectedValue="{Binding TimeFrame}"
                      ItemsSource="{Binding TimeFrames}"/>
            </HeaderedItemsControl>
            <HeaderedItemsControl Header="{x:Static l:Words.Date}">
                <ComboBox Width="{StaticResource Small}"
                      SelectedValue="{Binding DateMode}"
                      ItemsSource="{Binding DateModes}"
                      />
                <DatePicker SelectedDate="{Binding FromDate}" Width="{StaticResource Small}"/>
                <DatePicker SelectedDate="{Binding ToDate}" Width="{StaticResource Small}"/>
            </HeaderedItemsControl>
        </StackPanel>
        <StackPanel>
            <HeaderedItemsControl Header="{x:Static l:Words.Delays}">
                <ComboBox Width="{StaticResource Large}"
                      SelectedValue="{Binding ExecutionMode}"
                      ItemsSource="{Binding ExecutionModes}"
                      />
            </HeaderedItemsControl>
            <HeaderedItemsControl Header="{x:Static l:Words.Modelling}">
                <ComboBox Width="{StaticResource Large}" 
                      SelectedValue="{Binding Model}" 
                      ItemsSource="{Binding Models}"/>
            </HeaderedItemsControl>
            <HeaderedItemsControl Header="{x:Static l:Words.Deposit}">
                <ComboBox Width="{StaticResource Small}" 
                      SelectedValue="{Binding Deposit}" 
                      ItemsSource="{Binding Deposits}"/>
                <ComboBox Width="{StaticResource Small}"
                      SelectedValue="{Binding Currency}"
                      ItemsSource="{Binding Currencies}"/>
                <ComboBox Width="{StaticResource Small}"
                      SelectedValue="{Binding Leverage}"
                      ItemsSource="{Binding Leverages}"/>
            </HeaderedItemsControl>
        </StackPanel>
        <StackPanel>
            <HeaderedItemsControl Header="{x:Static l:Words.Optimization}">
                <ComboBox SelectedValue="{Binding Optimization}" 
                      Width="{StaticResource Large}"
                      ItemsSource="{Binding Optimizations}"/>
            </HeaderedItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
