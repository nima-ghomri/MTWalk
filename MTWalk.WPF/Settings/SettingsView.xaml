<UserControl x:Class="MTWalk.WPF.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:e="clr-namespace:MTWalk.WPF.Extensions"
             xmlns:l="clr-namespace:MTWalk.WPF.Localization"
             xmlns:local="clr-namespace:MTWalk.WPF.Settings"
             xmlns:windowing="clr-namespace:MTWalk.Windowing;assembly=MTWalk" xmlns:tree="clr-namespace:MTWalk.WPF.Controls.Tree"
             mc:Ignorable="d"        
             DataContext="{e:Resolve Type=local:SettingsViewModel}"
             d:DataContext="{d:DesignInstance Type=local:SettingsViewModel}"
             d:Background="White">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MTWalk.WPF;component/Settings/SettingsView.Styles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MTWalk.WPF;component/Converters/Converters.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Style="{StaticResource InputsPanel}">
        <StackPanel>
            <HeaderedItemsControl Header="{x:Static l:Strings.Terminal}">
                <ComboBox Width="{StaticResource Large}"
                />
            </HeaderedItemsControl>
        </StackPanel>
        <StackPanel>
            <HeaderedItemsControl Header="{x:Static l:Strings.Expert}">
                <tree:TreeComboBox 
                    Width="{StaticResource Large}" 
                    ItemsSource="{Binding Experts}"
                    DisplayMemberPath="RelativePath"
                    Text="{Binding Expert}"
                    NodeIcon="🎓"
                    NodeColor="DarkBlue"
                    TreeIcon="📁"
                    TreeColor="Gold"/>
            </HeaderedItemsControl>
            <HeaderedItemsControl Header="{x:Static l:Strings.Symbol}">
                <tree:TreeComboBox 
                   Width="{StaticResource Medium}" 
                   ItemsSource="{Binding Symbols}"
                   Text="{Binding Symbol}"
                   NodeIcon="💲"
                   NodeColor="Orange"
                   TreeIcon="▩"
                   TreeColor="DarkBlue"/>
                <ComboBox Width="{StaticResource Small}"
                      SelectedValue="{Binding TimeFrame}"
                      ItemsSource="{Binding TimeFrames}"/>
            </HeaderedItemsControl>
            <HeaderedItemsControl Header="{x:Static l:Strings.Date}">
                <ComboBox Width="{StaticResource Small}"
                      SelectedValue="{Binding DateMode}"
                      ItemsSource="{Binding DateModes}"
                      />
                <DatePicker 
                    Width="{StaticResource Small}"
                    SelectedDate="{Binding FromDate}"
                    IsEnabled="{Binding IsFromAndToDateEnabled}"
                    />
                <DatePicker 
                    Width="{StaticResource Small}"
                    SelectedDate="{Binding ToDate}" 
                    IsEnabled="{Binding IsFromAndToDateEnabled}"
                    />
            </HeaderedItemsControl>
        </StackPanel>
        <StackPanel>
            <HeaderedItemsControl Header="{x:Static l:Strings.Delays}">
                <ComboBox Width="{StaticResource Large}"
                      SelectedValue="{Binding ExecutionMode}"
                      ItemsSource="{Binding ExecutionModes}"
                      />
            </HeaderedItemsControl>
            <HeaderedItemsControl Header="{x:Static l:Strings.Modelling}">
                <ComboBox Width="{StaticResource Large}" 
                      SelectedValue="{Binding Model}" 
                      ItemsSource="{Binding Models}"/>
            </HeaderedItemsControl>
            <HeaderedItemsControl Header="{x:Static l:Strings.Deposit}">
                <ComboBox 
                    IsEditable="True"
                    Width="{StaticResource Small}"
                    Text="{Binding Deposit, Converter={StaticResource DoubleToStringConverter}}"
                    SelectedValue="{Binding Deposit}" 
                    ItemsSource="{Binding Deposits}"/>
                <ComboBox 
                    Width="{StaticResource Small}"
                    SelectedValue="{Binding Currency}"
                    ItemsSource="{Binding Currencies}"/>
                <ComboBox 
                    IsEditable="True"
                    Width="{StaticResource Small}"
                    Text="{Binding Leverage, Converter={StaticResource IntToStringConverter}, StringFormat='1:{0}'}"
                    SelectedValue="{Binding Leverage}"
                    ItemStringFormat="1:{0}"
                    ItemsSource="{Binding Leverages}"/>
            </HeaderedItemsControl>
        </StackPanel>
        <StackPanel>
            <HeaderedItemsControl Header="{x:Static l:Strings.Optimization}">
                <ComboBox SelectedValue="{Binding Optimization}" 
                      Width="{StaticResource Medium}"
                      ItemsSource="{Binding Optimizations}"/>
                <ComboBox SelectedValue="{Binding OptimizationCriterion}" 
                          Width="{StaticResource Small}"
                          ItemsSource="{Binding OptimizationCriteria}"/>
            </HeaderedItemsControl>
        </StackPanel>

        <StackPanel>
            <HeaderedItemsControl Header="{x:Static l:Strings.Walk}">
                <ComboBox 
                    SelectedValue="{Binding WindowType}" 
                    Width="{StaticResource Small}"
                    ItemsSource="{Binding WindowTypes}"
                    />
                <ContentControl Content="{Binding}" Margin="{StaticResource Gap}">
                    <ContentControl.Resources>
                        <DataTemplate x:Key="RollingTemplate">
                            <ComboBox 
                                Width="{StaticResource Small}"
                                SelectedValue="{Binding OptimizationSize}" 
                                ItemsSource="{Binding OptimizationSizes}"
                                IsEditable="True"/>
                        </DataTemplate>
                        <DataTemplate x:Key="AnchoredTemplate">
                            <DatePicker SelectedDate="{Binding AnchorDate}" Width="{StaticResource Small}"/>
                        </DataTemplate>
                    </ContentControl.Resources>
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowType}" Value="{x:Static windowing:WindowType.Rolling}">
                                    <Setter Property="ContentTemplate" Value="{StaticResource RollingTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding WindowType}" Value="{x:Static windowing:WindowType.Anchored}">
                                    <Setter Property="ContentTemplate" Value="{StaticResource AnchoredTemplate}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
                <ComboBox 
                    Width="{StaticResource Small}"
                    SelectedValue="{Binding ForwardSize}" 
                    ItemsSource="{Binding ForwardSizes}"
                    IsEditable="True"
                          />
            </HeaderedItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
