<Window x:Class="MTWalk.WPF.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:executionbar="clr-namespace:MTWalk.WPF.ExecutionBar"
        xmlns:e="clr-namespace:MTWalk.WPF.Extensions"
        xmlns:inputs="clr-namespace:MTWalk.WPF.Inputs"
        xmlns:l="clr-namespace:MTWalk.WPF.Localization"
        xmlns:local="clr-namespace:MTWalk.WPF.Main"
        xmlns:settings="clr-namespace:MTWalk.WPF.Settings"
        xmlns:viewers="clr-namespace:MTWalk.WPF.Viewers"
        mc:Ignorable="d"
        d:Height="400"
        d:Width="500"
        d:DataContext="{d:DesignInstance Type=local:MainWindowViewModel}"
        DataContext="{e:Resolve Type=local:MainWindowViewModel}"
        Title="{x:Static l:Names.MTWalk}"
        WindowState="Maximized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <viewers:ResultGraphView/>
        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"/>
        <Grid  Grid.Row="2" >
            <TabControl TabStripPlacement="Bottom">
                <TabItem Header="{x:Static l:Words.Settings}">
                    <settings:SettingsView/>
                </TabItem>
                <TabItem Header="{x:Static l:Words.Inputs}">
                    <inputs:InputsView/>
                </TabItem>
            </TabControl>
            <DockPanel VerticalAlignment="Bottom"
                       Margin="110,0,0,0">
                <executionbar:ExecutorView DockPanel.Dock="Right"/>
                <TextBlock Text="{Binding Text}" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
