<UserControl x:Class="MTWalk.WPF.ExecutionBar.ExecutorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MTWalk.WPF.ExecutionBar"
             xmlns:l="clr-namespace:MTWalk.WPF.Localization"
             xmlns:e="clr-namespace:MTWalk.WPF.Extensions"
             mc:Ignorable="d" 
             d:DesignHeight="30" 
             d:DesignWidth="100"
             d:DataContext="{d:DesignInstance Type=local:ExecutorViewModel}"
             DataContext="{e:Resolve Type=local:ExecutorViewModel}">
    <StackPanel Orientation="Horizontal">
        <Button Command="{Binding StartWalkerCommand}"
                Content="{x:Static l:Strings.Start}"/>
        <Button Command="{Binding StopWalkerCommand}"
                Content="{x:Static l:Strings.Stop}"/>
    </StackPanel>
</UserControl>
